{
  "name": "vfx-syntech",
  "private": true,
  "version": "0.9.0",
  "productName": "VFX SYNTECH",
  "description": "Audio/video-reactive VFX for videomakers",
  "author": "State",
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dist-desktop release server.js",
    "lint": "tsc --noEmit",
    "desktop:bundle": "esbuild desktop/main.ts --bundle --platform=node --format=cjs --external:electron --external:vite --outfile=dist-desktop/main.cjs",
    "desktop": "npm run build && npm run desktop:bundle && electron .",
    "desktop:dist": "npm run build && npm run desktop:bundle && electron-builder --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "three": "^0.128.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
